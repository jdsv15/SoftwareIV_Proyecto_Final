@model ProyectoFinal.Models.Especialidad

@{
    ViewData["Title"] = (Model.Id == 0 ? "Crear" : "Editar") + " Especialidad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h2 class="text-primary fw-bold">@(Model.Id == 0 ? "Nueva Especialidad" : "Editar Especialidad")</h2>
                    <hr />
                </div>
                <div class="card-body p-4 pt-2">
                    <form method="post" asp-action="Upsert">
                        <input asp-for="Id" hidden />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-4">
                            <label asp-for="Nombre" class="form-label font-weight-bold">Nombre de la Especialidad</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Pediatría" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-6">
                                <button type="submit" class="btn btn-primary w-100">
                                    @(Model.Id == 0 ? "Guardar" : "Actualizar")
                                </button>
                            </div>
                            <div class="col-6">
                                <a asp-action="Index" class="btn btn-outline-secondary w-100">Cancelar</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}