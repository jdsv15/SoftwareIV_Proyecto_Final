@model IEnumerable<ProyectoFinal.Models.Especialidad>

@{
    ViewData["Title"] = "Gestión de Especialidades";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2 class="text-primary">Especialidades Médicas</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="CrearEspecialidad" class="btn btn-success">
                + Agregar Nueva Especialidad
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <table class="table table-bordered table-striped table-hover mt-2">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Nombre de la Especialidad</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle">@item.Nombre</td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="EditarEspecialidad" asp-route-id="@item.Id" class="btn btn-warning btn-sm mx-1">
                                            Editar
                                        </a>
                                        <a asp-action="EliminarEspecialidad" asp-route-id="@item.Id" class="btn btn-danger btn-sm mx-1">
                                            Eliminar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info text-center mt-3">
                    <strong>No hay especialidades registradas en el sistema.</strong>
                </div>
            }
        </div>
    </div>
</div>