@model IEnumerable<ProyectoFinal.Models.Especialidad>

@{
    ViewData["Title"] = "Especialidades";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/font/bootstrap-icons.css">

<div class="container p-4">
    <div class="row pb-3">
        <div class="col-6">
            <h2 class="text-primary">Lista de Especialidades</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-area="Administracion" asp-controller="Admin" asp-action="Upsert" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Crear Nueva Especialidad
            </a>
        </div>
    </div>

    <table class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
                <th>Nombre</th>
                <th class="text-center" style="width: 30%">Acciones</th>
            </tr>
        </thead>
        <tbody id="tbodyEspecialidades">
        </tbody>
    </table>
</div>

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

<script>
    $(document).ready(function () {
        cargarEspecialidades();
    });

    // traer los datos desde el Controlador
    function cargarEspecialidades() {
        $.ajax({
            url: '/Administracion/Admin/GetAll',
            type: 'GET',
            success: function (resultado) {
                let filas = '';

                $.each(resultado.data, function (index, especialidad) {
                    filas += `
                        <tr>
                            <td>${especialidad.nombre}</td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a href="/Administracion/Admin/Upsert?id=${especialidad.id}" class="btn btn-primary mx-2">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                    <button onClick="eliminarEspecialidad(${especialidad.id})" class="btn btn-danger mx-2">
                                        <i class="bi bi-trash-fill"></i> Borrar
                                    </button>
                                </div>
                            </td>
                        </tr>`;
                });

               
                $('#tbodyEspecialidades').html(filas);
            }
        });
    }

    // eliminar un registro
    function eliminarEspecialidad(id) {
        if (confirm("¿Estás seguro de que deseas eliminar esta especialidad?")) {
            $.ajax({
                url: '/Administracion/Admin/Delete/' + id,
                type: 'DELETE',
                success: function (resultado) {
                    if (resultado.success) {
                        // Si se borro refrescamos la lista
                        cargarEspecialidades();
                    } else {
                        alert(resultado.message);
                    }
                }
            });
        }
    }
</script>