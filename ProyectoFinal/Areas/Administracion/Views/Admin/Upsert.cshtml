@model ProyectoFinal.Models.Especialidad

@{
    ViewData["Title"] = (Model.Id == 0 ? "Crear" : "Editar") + " Especialidad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<form method="post" asp-action="Upsert">
    <input asp-for="Id" hidden />

    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">@(Model.Id == 0 ? "Crear Nueva" : "Editar") Especialidad</h2>
            <hr />
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3 row">
            <label asp-for="Nombre" class="p-0 font-weight-bold mb-1">Nombre de la Especialidad</label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-6 col-md-3">
                @if (Model.Id == 0)
                {
                    <button type="submit" class="btn btn-primary form-control">Crear</button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary form-control">Actualizar</button>
                }
            </div>
            <div class="col-6 col-md-3">
                <a asp-action="Especialidades" class="btn btn-outline-secondary form-control">
                    Regresar a la Lista
                </a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}