@model ProyectoFinal.Models.Padecimiento

@{
    ViewData["Title"] = "Gestionar Padecimiento";
}

<form method="post" asp-action="Upsert">
    @* input oculto para que el sistema sepa si estamos editando o creando *@
    <input type="hidden" asp-for="Id" />

    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">@(Model.Id != 0 ? "Editar" : "Crear") Padecimiento</h2>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion"></label>
            <input asp-for="Descripcion" class="form-control" />
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary" style="width:150px">
            @(Model.Id != 0 ? "Actualizar" : "Crear")
        </button>
        <a asp-action="Index" class="btn btn-secondary" style="width:150px">Regresar</a>
    </div>
</form>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}