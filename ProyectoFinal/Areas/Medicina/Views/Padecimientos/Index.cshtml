@model IEnumerable<ProyectoFinal.Models.Padecimiento>

@{
    ViewData["Title"] = "Listado de Padecimientos";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-uppercase mb-0" style="letter-spacing: 4px;">
                    Gestión de Padecimientos
                </h2>

                <a asp-area="Medicina"
                   asp-controller="Padecimientos"
                   asp-action="Upsert"
                   class="btn btn-dark px-4">
                    Nuevo Padecimiento
                </a>
            </div>

            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Nombre</td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Descripcion))
                                    {
                                        @item.Descripcion
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin descripción registrada</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <a asp-area="Medicina"
                                       asp-controller="Padecimientos"
                                       asp-action="Upsert"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">
                                        Editar
                                    </a>

                                    <form asp-area="Medicina"
                                          asp-controller="Padecimientos"
                                          asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('¿Está seguro de eliminar este padecimiento?');">
                                            Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                No hay padecimientos registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>