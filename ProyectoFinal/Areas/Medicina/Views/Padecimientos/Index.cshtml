@model IEnumerable<ProyectoFinal.Models.Paciente>

@{
    ViewData["Title"] = "Listado de Pacientes";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">

            <h2 class="text-uppercase mb-4" style="letter-spacing: 4px;">
                Directorio de Pacientes
            </h2>

            <form asp-action="Index" method="get" class="mb-4">
                <div class="input-group">
                    <input type="text"
                           name="busqueda"
                           class="form-control"
                           placeholder="Buscar por nombre o cédula..."
                           value="@Context.Request.Query["busqueda"]" />

                    <button type="submit" class="btn btn-dark px-4">
                        Buscar
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        Limpiar
                    </a>
                </div>
            </form>

            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Cédula</th>
                        <th>Nombre completo</th>
                        <th>Última atención</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Cedula</td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Nombre))
                                    {
                                        @item.Nombre
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin nombre registrado</span>
                                    }
                                </td>

                                <td>
                                    @if (item.FechaUltimaAtencion.HasValue)
                                    {
                                        @item.FechaUltimaAtencion.Value.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin atenciones previas</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <a asp-area="Medicina"
                                       asp-controller="Pacientes"
                                       asp-action="Expediente"
                                       asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm text-white">
                                        <i class="bi bi-folder2-open"></i> Ver expediente
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                No hay pacientes registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>